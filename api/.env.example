# Copy to api/.env for local development; never commit real credentials.
ConnectionStrings__Wiki=Host=localhost;Port=5432;Database=worldbuilding;Username=worldbuilding;Password=replace-with-a-local-password
ASPNETCORE_URLS=http://localhost:5080
ASPNETCORE_ENVIRONMENT=Development
OwnerSetup__Key=replace-with-a-long-random-one-time-key
ForwardedHeaders__KnownProxies__0=127.0.0.1
Email__PublicOrigin=http://localhost:3000
Email__From=wiki@example.invalid
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
